# Copy to .env.local for local development.
# Both are read at BUILD time only — this site is a static export, so the blog
# is baked in when the site builds, not fetched per request.

# Strapi (rizely-cms). Local dev: http://localhost:1337
# Production: the Railway URL, e.g. https://rizely-cms-production.up.railway.app
STRAPI_URL=http://localhost:1337

# Optional. Public read access is granted in rizely-cms's bootstrap, so the
# blog builds without a token. Set one only if the Public role is locked down.
STRAPI_API_TOKEN=
